# CTRAIL Gateway Configuration
# Copy this file to .env and fill in the values for your environment

# NEF Connection
# URL of the 3GPP NEF server (e.g., free5GC NEF)
NEF_BASE_URL=http://nef:8000

# Authentication token for the NEF API
NEF_TOKEN=your-nef-token-here

# Server Configuration
SERVER_PORT=8080

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Profiling (pprof) — leave empty to disable
# When set, exposes Go pprof endpoints at http://localhost:<port>/debug/pprof/
# Example: PPROF_PORT=6060
PPROF_PORT=

# ---------------------------------------------------------------------------
# Edge Application Management (EAM) — Kubernetes as MEC orchestrator
# ---------------------------------------------------------------------------
# Enable the /apps, /deployments and /clusters endpoints. Requires a reachable
# Kubernetes cluster. Leave false to run the Traffic Influence instance only.
EAM_ENABLED=false

# Path to a kubeconfig file. Leave empty to use in-cluster config (when CTRAIL
# runs as a pod with a ServiceAccount). Example: KUBECONFIG=/home/user/.kube/config
KUBECONFIG=

# Prefix for the Kubernetes namespaces CTRAIL creates per edge cloud zone.
K8S_NAMESPACE_PREFIX=ctrail-

# OAI MEP (ETSI MEC 011 mp1) service registration — optional value-add.
# When enabled, externally-visible deployment services are registered so other
# MEC applications can discover them.
MEP_ENABLED=false
MEP_BASE_URL=http://oai-mep.org/service_registry/v1
